@model ClienteFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<fieldset class="form-section">
    <legend>Dados de identificação</legend>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="NomeCompleto" class="form-label"></label>
            <input asp-for="NomeCompleto" class="form-control" autocomplete="name" autofocus />
            <span asp-validation-for="NomeCompleto" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cpf" class="form-label"></label>
            <input asp-for="Cpf" class="form-control" inputmode="numeric" autocomplete="off" />
            <span asp-validation-for="Cpf" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Telefone" class="form-label"></label>
            <input asp-for="Telefone" class="form-control" inputmode="tel" autocomplete="tel" />
            <span asp-validation-for="Telefone" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
    </div>
</fieldset>

<fieldset class="form-section">
    <legend>Endereço</legend>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Cep" class="form-label"></label>
            <input asp-for="Cep" class="form-control" inputmode="numeric" autocomplete="postal-code" />
            <span asp-validation-for="Cep" class="field-validation-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Logradouro" class="form-label"></label>
            <input asp-for="Logradouro" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="Logradouro" class="field-validation-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Numero" class="form-label"></label>
            <input asp-for="Numero" class="form-control" autocomplete="address-line2" />
            <span asp-validation-for="Numero" class="field-validation-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Complemento" class="form-label"></label>
            <input asp-for="Complemento" class="form-control" />
            <span asp-validation-for="Complemento" class="field-validation-error"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Bairro" class="form-label"></label>
            <input asp-for="Bairro" class="form-control" />
            <span asp-validation-for="Bairro" class="field-validation-error"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Cidade" class="form-label"></label>
            <input asp-for="Cidade" class="form-control" autocomplete="address-level2" />
            <span asp-validation-for="Cidade" class="field-validation-error"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Estado" class="form-label"></label>
            <input asp-for="Estado" class="form-control text-uppercase" autocomplete="address-level1" maxlength="2" />
            <span asp-validation-for="Estado" class="field-validation-error"></span>
        </div>
    </div>
</fieldset>
