@model AparelhosIndexViewModel
@{
    ViewData["Title"] = "Aparelhos";
}

<section aria-labelledby="aparelhos-title">
    <div class="page-heading page-heading-actions">
        <div>
            <p class="eyebrow">Atendimento</p>
            <h1 id="aparelhos-title">Aparelhos</h1>
            <p class="page-subtitle">Localize aparelhos por tipo, marca, modelo, IMEI/nº de série ou proprietário.</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Pesquisar" method="post" class="search-form">
                <label for="busca" class="form-label">Pesquisar aparelhos</label>
                <div class="input-group">
                    <input id="busca" name="busca" value="@Model.Busca" class="form-control" type="search" placeholder="Tipo, marca, modelo, IMEI/nº de série ou nome do cliente" autocomplete="off" />
                    <button class="btn btn-primary" type="submit">Pesquisar</button>
                </div>
                <p class="form-text mb-0">O IMEI/número de série pode ser parcial. A busca unificada da página Busca continua disponível para consultas cruzadas.</p>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center gap-3">
            <h2 class="h5 mb-0">@(string.IsNullOrWhiteSpace(Model.Busca) ? "Aparelhos cadastrados" : "Resultado da pesquisa")</h2>
            <span class="text-muted small">@Model.Aparelhos.Count registro(s)</span>
        </div>
        @if (Model.Aparelhos.Count == 0)
        {
            <div class="card-body text-center text-muted py-5">Nenhum aparelho encontrado.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover client-table mb-0">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Cor</th>
                            <th>IMEI/Nº de série</th>
                            <th>Proprietário</th>
                            <th>Cadastro</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aparelho in Model.Aparelhos)
                        {
                            <tr>
                                <td data-label="Tipo">@aparelho.TipoAparelho</td>
                                <td data-label="Marca">@aparelho.Marca</td>
                                <td data-label="Modelo">@(string.IsNullOrWhiteSpace(aparelho.Modelo) ? "—" : aparelho.Modelo)</td>
                                <td data-label="Cor">@(aparelho.Cor ?? "—")</td>
                                <td data-label="IMEI/Nº de série">@(aparelho.ImeiNumeroSerie ?? "—")</td>
                                <td data-label="Proprietário" class="fw-semibold">@aparelho.Cliente?.NomeCompleto</td>
                                <td data-label="Cadastro">@aparelho.DataCadastro.ToString("dd/MM/yyyy")</td>
                                <td data-label="Ações" class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@aparelho.Id">Detalhes</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@aparelho.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Clientes" asp-action="Details" asp-route-id="@aparelho.ClienteId">Ver cliente</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
