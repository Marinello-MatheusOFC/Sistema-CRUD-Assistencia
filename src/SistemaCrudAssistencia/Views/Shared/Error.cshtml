@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro</h1>
<h2 class="h5 text-danger">Ocorreu um erro ao processar a sua solicitação.</h2>

<p>
    Tente novamente e, se o problema persistir, contate o administrador do sistema.
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador da requisição:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3 class="h6">Modo de desenvolvimento</h3>
<p>
    Ao executar a aplicação no ambiente de <strong>Development</strong>, informações
    detalhadas sobre o erro são exibidas na tela.
</p>
<p>
    <strong>O ambiente de Development não deve ser habilitado em produção.</strong>
    Ele pode expor informações sensíveis aos usuários. Para depurar localmente,
    defina a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como
    <strong>Development</strong> e reinicie a aplicação.
</p>
