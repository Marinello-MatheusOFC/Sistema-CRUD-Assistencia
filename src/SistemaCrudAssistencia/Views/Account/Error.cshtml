@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="h5 text-danger mb-2">Erro</h1>
                <p class="text-muted mb-4">
                    Ocorreu um erro inesperado ao processar a sua solicitação.
                    Tente novamente e, se o problema persistir, contate o administrador do sistema.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="small mb-4">
                        <strong>Identificador da requisição:</strong>
                        <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Ir para a tela de entrada</a>
            </div>
        </div>
    </div>
</div>
