@model StatusHttpViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <p class="display-4 text-danger mb-0">@Model.Codigo</p>
                <h1 class="h5 mb-2">@Model.Titulo</h1>
                <p class="text-muted mb-4">@Model.Mensagem</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Ir para a tela de entrada</a>
            </div>
        </div>
    </div>
</div>
