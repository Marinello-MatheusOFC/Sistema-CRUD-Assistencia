@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h5 text-center mb-1">Sistema de Assistência Técnica</h1>
                <p class="text-center text-muted small mb-4">Acesso restrito à equipe interna.</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="text-danger d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Senha" class="text-danger d-block"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="ManterConectado" class="form-check-input" type="checkbox" />
                        <label asp-for="ManterConectado" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
