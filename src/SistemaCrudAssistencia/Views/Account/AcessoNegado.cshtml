@{
    ViewData["Title"] = "Acesso negado";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="h5 text-danger mb-2">Acesso negado</h1>
                <p class="text-muted mb-4">
                    Você não tem permissão para acessar esta área do sistema.
                    Se você acredita que isso é um erro, entre em contato com o administrador.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Ir para a tela de entrada</a>
            </div>
        </div>
    </div>
</div>
