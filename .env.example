# ==============================================================================
# Variáveis de ambiente - Sistema CRUD Assistência
# ==============================================================================
# Copie este arquivo para ".env" (está no .gitignore e NUNCA deve ser versionado)
# e ajuste os valores:
#
#   Windows PowerShell:  copy .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# O arquivo .env é consumido automaticamente pelo "docker compose up".
# O "dotnet run" NÃO lê .env — exporte as variáveis no terminal (veja o README).
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMEIRO USUÁRIO (obrigatório no Docker Compose)
# ------------------------------------------------------------------------------
# Criado pelo seed apenas se ainda não existir nenhum usuário (em qualquer ambiente).
# A senha precisa atender à política do Identity: mínimo 8 caracteres, com
# maiúscula, minúscula e dígito. Não existe cadastro público no sistema.
ADMIN_EMAIL="admin@exemplo.local"
ADMIN_PASSWORD="TroqueEstaSenha123!"

# ------------------------------------------------------------------------------
# BANCO DE DADOS (Docker Compose)
# ------------------------------------------------------------------------------
# LOCAL/DEV: valor padrão usado pelo container PostgreSQL local ("assistencia-dev-local").
# Troque para outra senha se quiser — o compose monta a connection string da
# aplicação a partir desta variável. Em produção use uma senha forte própria.
POSTGRES_PASSWORD="assistencia-dev-local"

# Portas publicadas na máquina local (apenas 127.0.0.1)
#APP_PORT=8080
#POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------------------------
# Ambiente: Development (padrão do compose) | Production
# Em Production as migrations não são aplicadas automaticamente (veja o README).
ASPNETCORE_ENVIRONMENT="Development"

# ------------------------------------------------------------------------------
# CONEXÃO COM O BANCO FORA DO DOCKER (dotnet run / publicação própria)
# ------------------------------------------------------------------------------
# O dotnet run não lê este arquivo: copie a linha abaixo para o terminal
# (ou defina como variável de ambiente do sistema/serviço).
#
# PostgreSQL local:
# ConnectionStrings__Default="Host=localhost;Port=5432;Database=assistencia;Username=postgres;Password=assistencia-dev-local;SSL Mode=Disable"
#
# Qualquer provedor/gerenciado (SSL conforme o provedor):
# ConnectionStrings__Default="Host=SEU_HOST;Port=5432;Database=SEU_BANCO;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require"
#
# URL de escuta local (padrão do launchSettings: http://localhost:5002)
# ASPNETCORE_URLS="http://localhost:5002"
