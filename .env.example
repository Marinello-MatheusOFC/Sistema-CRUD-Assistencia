# ==============================================================================
# Variaveis de ambiente - Sistema CRUD Assistencia
# ==============================================================================
# Copie este arquivo para ".env" (que esta no .gitignore e NUNCA deve ser
# versionado) e ajuste os valores.
#
#   Windows PowerShell:
#     copy .env.example .env
#
#   Linux / macOS / Docker:
#     cp .env.example .env
#
# Acesse o PostgreSQL "sem SSL" e SEM usar o pooler para desenvolvimento.
# ==============================================================================

# ------------------------------------------------------------------------------
# CONEXAO COM O BANCO
# ------------------------------------------------------------------------------
# Neon (producao) - https://console.neon.tech -> Connection Details -> Pooled connection
# ConnectionStrings__Default="Host=ep-xxx.sa-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=True"

# PostgreSQL local (opcao A - via docker-compose.yml)
ConnectionStrings__Default="Host=localhost;Port=5432;Database=assistencia;Username=postgres;Password=postgres;SSL Mode=Disable"

# Neon branch de desenvolvimento (opcao B - free e nao exige instalar nada)
# ConnectionStrings__Default="Host=ep-dev-xxx.sa-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=True"

# ------------------------------------------------------------------------------
# USUARIO ADMINISTRATIVO INICIAL
# ------------------------------------------------------------------------------
# Criado apenas se ainda nao existir e somente em Development.
# Em producao, defina ADMIN_PASSWORD no deploy ou use o comando documentado no README.
ADMIN_EMAIL="admin@assistencia.local"
ADMIN_PASSWORD="TroqueEstaSenha123!"

# ------------------------------------------------------------------------------
# APLICACAO
# ------------------------------------------------------------------------------
# Ambiente: Development | Staging | Production
ASPNETCORE_ENVIRONMENT="Development"

# URL publica usada para gerar links e cookie seguro (producao com HTTPS)
ASPNETCORE_URLS="http://localhost:5099"

# OBRIGATORIO em producao: "true" faz o sistema recusar envio de e-mail real.
# Sem servidor SMTP configurado, deixe sempre "true".
# Requer: Authentication__RequiresConfirmedAccount=false
EnableEmailConfirmation="false"
